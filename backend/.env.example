# ---------- Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL  (DB_ENGINE=sqlite for a quick test without Postgres)
DB_ENGINE=postgres
DB_NAME=resume_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---------- Redis + Celery
USE_REDIS=True
REDIS_URL=redis://localhost:6379/0
# True = resume analysis runs in Celery worker; False = runs instantly (easier)
ASYNC_PROCESSING=False

# ---------- Live Jobs APIs
# Remotive + Jobicy + Arbeitnow: real remote jobs, NO key needed
FREE_JOB_APIS=True
# Adzuna = real India city jobs (Pune, Mumbai...) - free key
# Adzuna: https://developer.adzuna.com  -> App ID + App Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# JSearch (LinkedIn/Indeed/Glassdoor) on RapidAPI - optional
JSEARCH_API_KEY=

# ---------- Generative AI (optional): Mock Interview, Resume Improver, Cover Letter
# Free key: https://aistudio.google.com/apikey  (leave empty = built-in rule engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- AI matcher: auto | tfidf
MATCHER_BACKEND=auto

# ---------- Email (forgot password codes + job alerts)
# Option A (laptop): Gmail App Password -> https://myaccount.google.com/apppasswords (needs 2-Step Verification)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Option B (Render live site, SMTP is blocked there): Brevo free API key -> https://www.brevo.com
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=JobMatch AI
# Nothing set: on the laptop the reset code is shown on the page and printed in this terminal.
